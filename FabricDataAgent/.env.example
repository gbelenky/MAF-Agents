# Fabric Data Agent Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Fabric Data Agent Connection
# =============================================================================
# IMPORTANT: Your Data Agent must be PUBLISHED first for queries to work!
#
# Option 1: Published URL (recommended)
# Go to your Data Agent in Fabric → Click "Publish" → Settings → Copy "Published URL"
# FABRIC_PUBLISHED_URL=https://api.fabric.microsoft.com/v1/workspaces/{workspace_id}/dataagents/{agent_id}/openai
#
# Option 2: Workspace ID + Agent Item ID (will construct the URL)
# Find these in your Fabric portal URL:
# https://app.fabric.microsoft.com/groups/{WORKSPACE_ID}/dataagents/{AGENT_ITEM_ID}

FABRIC_WORKSPACE_ID=your-workspace-guid-here
FABRIC_AGENT_ITEM_ID=your-data-agent-item-id-here

# =============================================================================
# AUTHENTICATION OPTIONS
# =============================================================================
# DefaultAzureCredential tries multiple authentication methods.
# Configure ONE of the following options:

# Option 1: Service Principal (for production/automation)
# --------------------------------------------------------
# Register an app in Azure AD with Fabric API permissions
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-app-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# Option 2: Azure CLI (for development)
# --------------------------------------------------------
# Run: az login
# No environment variables needed - uses cached credentials

# Option 3: Managed Identity (for Azure-hosted apps)
# --------------------------------------------------------
# No environment variables needed - automatically detected in Azure
# Ensure your Azure resource has a managed identity with Fabric access

# Option 4: Interactive Browser (for development)
# --------------------------------------------------------
# Set use_interactive_auth=True in StandaloneDataAgentClient()
# No environment variables needed - opens browser for login

# =============================================================================
# AZURE AD APP REGISTRATION (for Service Principal)
# =============================================================================
# To create a service principal for Fabric access:
#
# 1. Go to Azure Portal > Azure Active Directory > App registrations
# 2. Click "New registration"
# 3. Name your app, select "Accounts in this organizational directory only"
# 4. After creation, go to "API permissions"
# 5. Add permission > APIs my organization uses > "Power BI Service"
# 6. Add delegated permission: "Dataset.Read.All" (or other needed permissions)
# 7. Go to "Certificates & secrets" > "New client secret"
# 8. Copy the secret value to AZURE_CLIENT_SECRET
# 9. Copy Application (client) ID to AZURE_CLIENT_ID
# 10. Copy Directory (tenant) ID to AZURE_TENANT_ID
#
# Note: You may also need to grant admin consent for the permissions
