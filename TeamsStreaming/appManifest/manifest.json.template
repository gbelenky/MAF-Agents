{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "{{MANIFEST_VERSION}}",
  "id": "{{BOT_ID}}",
  "developer": {
    "name": "Your Organization",
    "websiteUrl": "https://{{BOT_DOMAIN}}",
    "privacyUrl": "https://privacy.microsoft.com/privacystatement",
    "termsOfUseUrl": "https://www.microsoft.com/legal/terms-of-use"
  },
  "name": {
    "short": "{{BOT_NAME}}",
    "full": "{{BOT_NAME_FULL}}"
  },
  "description": {
    "short": "AI-powered bot with real-time streaming responses",
    "full": "This bot demonstrates Microsoft Agent Framework integration with Teams, featuring real-time streaming responses. Ask questions and see the AI generate responses in real-time!"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#5B5FC7",
  "bots": [
    {
      "botId": "{{BOT_ID}}",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal", "team", "groupChat"],
          "commands": [
            {
              "title": "help",
              "description": "Show help information"
            },
            {
              "title": "hello",
              "description": "Say hello to the bot"
            }
          ]
        }
      ]
    }
  ],
  "validDomains": [
    "{{BOT_DOMAIN}}"
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "webApplicationInfo": {
    "id": "{{BOT_ID}}",
    "resource": "api://{{BOT_DOMAIN}}/{{BOT_ID}}"
  }
}
