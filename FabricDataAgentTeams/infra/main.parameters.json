{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "botClientId": {
      "value": "${BOT_CLIENT_ID}"
    },
    "fabricWorkspaceId": {
      "value": "${FABRIC_WORKSPACE_ID}"
    },
    "fabricAgentItemId": {
      "value": "${FABRIC_AGENT_ITEM_ID}"
    },
    "enableBot": {
      "value": true
    }
  }
}
